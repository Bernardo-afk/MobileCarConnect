<?xml version="1.0" encoding="utf-8"?>
<!-- MobileCarConnect launcher icon. The mark is drawn inside the 66dp safe zone of the 108dp canvas, so no
     inset is needed. To swap the logo, replace the drawables generated by design/logo/tools/build_logo.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mobilecarconnect_icon_background" />
    <foreground android:drawable="@drawable/mobilecarconnect_icon_foreground" />
    <monochrome android:drawable="@drawable/mobilecarconnect_icon_monochrome" />
</adaptive-icon>
